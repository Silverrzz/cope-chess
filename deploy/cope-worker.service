[Unit]
Description=COPE Chess worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cope-worker
Group=cope-worker
EnvironmentFile=/etc/cope/worker.env
Environment=COPE_UPDATE_ROOT=/opt/cope-worker
WorkingDirectory=/var/lib/cope-worker
ExecStart=/opt/cope-worker/current/venv/bin/cope worker --server-url ${COPE_WORKER_SERVER_URL} --token-file /etc/cope/worker.token --state-file /var/lib/cope-worker/worker.json
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cope-worker /opt/cope-worker

[Install]
WantedBy=multi-user.target
